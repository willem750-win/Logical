  for YY := 0 to KnopUp.Height - 1 do
      for XX := 0 to KnopDown.Width - 1 do
      begin
        PixelColor := KnopDown.Canvas.Pixels[XX, YY];
        // Als de pixelkleur in de buurt van wit is, maak deze dan transparant
