  begin
   FDown4 := Value;
   FDepressed4:=value;
   If Value=true then Fpuls4:=4 else FPuls4:=0;
   FPuls:=FPuls8+FPuls4+FPuls2+FPuls1;
   invalidate;
  end;
end;
