procedure TjanConnector.AnchorCorner(logTL: TPoint; ACorner: TjanConMode);
var Rc:TRect;
begin
  ConMode:=ACorner;
  Rc:=boundsrect;
  ConHot:=ConPos;
  case Acorner of
  jcmTL:
    begin
      ConOffset:=point(Rc.left-logTL.x,Rc.top-logTL.y);
      ConAnchor:=parent.ScreenToClient(clienttoscreen(point(width,height)));
    end;
  jcmTR:
    begin
      ConOffset:=point(Rc.Right-logTL.x,Rc.top-logTL.y);
      ConAnchor:=parent.ScreenToClient(clienttoscreen(point(0,height)));
    end;
  jcmBR:
    begin
      ConOffset:=point(Rc.Right-logTL.x,Rc.bottom-logTL.y);
      ConAnchor:=parent.ScreenToClient(clienttoscreen(point(0,0)));
    end;
  jcmBL:
    begin
      ConOffset:=point(Rc.left-logTL.x,Rc.bottom-logTL.y);
      ConAnchor:=parent.ScreenToClient(clienttoscreen(point(width,0)));
    end;
  end;
end;

// Koppelt deze draad aan een component met (vergrote) rechthoek R als
// een van de twee UITEINDEN van de draad in R ligt. De uiteinden hangen
// af van de vorm: jcsTLBR = linksboven/rechtsonder, jcsTRBL =
// rechtsboven/linksonder. De andere twee hoeken zijn geen uiteinde en
// worden bewust niet getest: bij een (bijna) rechte draad liggen die ook
// binnen R, en wie daarop ankert verschuift de koppeling en krijgt een
// conPos die niet bij de vorm past (de draad wordt dan niet getekend).
function TjanConnector.AnchorToRect(const R: TRect; logTL: TPoint): Boolean;
var Rc:TRect;
begin
  Result:=True;
  Rc:=BoundsRect;
  if Shape=jcsTLBR then
  begin
    if PtInRect(R,Point(Rc.Left,Rc.Top)) then AnchorCorner(logTL,jcmTL)
    else if PtInRect(R,Point(Rc.Right,Rc.Bottom)) then AnchorCorner(logTL,jcmBR)
    else Result:=False;
  end
  else
  begin
    if PtInRect(R,Point(Rc.Right,Rc.Top)) then AnchorCorner(logTL,jcmTR)
    else if PtInRect(R,Point(Rc.Left,Rc.Bottom)) then AnchorCorner(logTL,jcmBL)
    else Result:=False;
  end;
end;

// Hoeveel moet het gesleepte component (linkerbovenhoek logTL) nog
// verschuiven zodat deze draad exact recht ligt? Vergelijkt het
// aansluitblokje aan het bewegende uiteinde met dat aan het vaste
// uiteinde. Geeft True met dY (liggende draad) of dX (staande draad);
// de andere waarde is 0. Alleen geldig na AnchorCorner.
function TjanConnector.StraightenDelta(logTL: TPoint; out dX, dY: Integer): Boolean;
var d:integer;
    nc,M,S:TPoint;
begin
  d:=conSize;
  nc:=point(logTL.x+ConOffset.x,logTL.y+ConOffset.y);
  // linkerbovenhoek van het blokje aan het bewegende uiteinde (M) en aan
  // het vaste uiteinde (S), afhankelijk van welke hoek vastgemaakt werd
  case conMode of
    jcmTL: begin M:=nc;                        S:=point(ConAnchor.x-d,ConAnchor.y-d); end;
    jcmTR: begin M:=point(nc.x-d,nc.y);        S:=point(ConAnchor.x,ConAnchor.y-d);   end;
    jcmBR: begin M:=point(nc.x-d,nc.y-d);      S:=ConAnchor;                          end;
  else     begin M:=point(nc.x,nc.y-d);        S:=point(ConAnchor.x-d,ConAnchor.y);   end;
  end;
  dX:=0; dY:=0;
  if Abs(S.x-M.x)>=Abs(S.y-M.y) then dY:=S.y-M.y   // liggende draad
  else dX:=S.x-M.x;                                // staande draad
  Result:=(dX<>0) or (dY<>0);
end;

// Magnetisch rechttrekken: ligt een draad aan het gesleepte component
// binnen WireStraightenTol pixels van recht, dan schuift het component
// dat laatste stukje bij. De kleinste correctie per richting wint.
const
  WireStraightenTol = 6;

procedure StraightenWires(AConnectors: TList; var ANewLeft, ANewTop: Integer);
var i,dX,dY,BestX,BestY:integer;
begin
  if (AConnectors=nil) or (AConnectors.Count=0) then exit;
  BestX:=WireStraightenTol+1;
  BestY:=WireStraightenTol+1;
  for i:=0 to AConnectors.Count-1 do
    if TjanConnector(AConnectors[i]).StraightenDelta(point(ANewLeft,ANewTop),dX,dY) then
    begin
      if (dY<>0) and (Abs(dY)<Abs(BestY)) then BestY:=dY;
      if (dX<>0) and (Abs(dX)<Abs(BestX)) then BestX:=dX;
    end;
  if Abs(BestY)<=WireStraightenTol then Inc(ANewTop,BestY);
  if Abs(BestX)<=WireStraightenTol then Inc(ANewLeft,BestX);
end;

// ============================================================
// Voedingsrails
// ============================================================

function IsRailInput(C: TControl): Boolean;
begin
  Result := (C is TjanSimButton) or (C is TjanSimKnop) or (C is TjanSimSensor) or
            (C is TjanSimWarm) or (C is TjanSimPuls) or (C is TjanDipSwitsh) or
            (C is TjanSimEindschakelaar);
end;

function IsRailOutput(C: TControl): Boolean;
begin
  Result := (C is TjanSimLight) or (C is TjanSimRelais) or
            (C is TjanSimBuzzer) or (C is TjanDisplay) or (C is TjanSimMotor) or
            (C is TjanSimPersoon);
end;

function PanelHasRails(P: TWinControl): Boolean;
var
  i: Integer;
begin
  Result := False;
  if P = nil then Exit;
  for i := 0 to P.ControlCount - 1 do
    if (P.Controls[i] is TjanRail) and P.Controls[i].Visible then
      Exit(True);
end;

// ------------------------------------------------------------
// Voedingsdraden: een gewone draad (TjanConnector) van de lijn van een
// rail naar het voedingsbolletje van een component werkt als inpluggen.
// ------------------------------------------------------------
const
  RailWireTol = 3;   // zo dicht bij de raillijn / het bolletje telt een draadeinde

// midden van het voedingsbolletje van C: links (+ kant, invoer en R1 van het
// schakelrelais) of rechts (- kant, uitvoer), op de hoogte van de
// ingangs- of uitgangsdraad
function PowerDotSym(C: TControl; APlusSide: Boolean; S: TjanSymbolen): TPoint;
var
  Y: Integer;
begin
  Y := C.Top + C.Height div 2;
  // schemasymbolen: het bolletje op de hoogte van de ingangsdraad
  if APlusSide and (S <> Afbeelding) then
  begin
    if C is TjanSimButton then Y := C.Top + 29
    else if C is TjanSimKnop then Y := C.Top + 47
    else if C is TjanSimWarm then Y := C.Top + 17;
  end;
  // en bij de uitvoer op de hoogte van de uitgangsdraad naar de - rail
  if (not APlusSide) and (S <> Afbeelding) then
  begin
    if C is TjanSimLight then Y := C.Top + 6
    else if C is TjanSimBuzzer then Y := C.Top + 32;   // BuzzerLegY(21, 13)
  end;
  // schakelrelais: R- zit altijd rechts op hoogte 38, R1 links op 12
  if (not APlusSide) and (C is TjanSchakelRelais) then Y := C.Top + 38;
  if APlusSide and (C is TjanSchakelRelais) then Y := C.Top + 12;
  if APlusSide then
    Result := Point(C.Left - 4, Y)
  else
    Result := Point(C.Left + C.Width + 4, Y);
end;

function PowerDot(C: TControl; APlusSide: Boolean): TPoint;
begin
  Result := PowerDotSym(C, APlusSide, SymOf(C));
end;

// de rail waarvan de lijn door Pt loopt (binnen RailWireTol), anders nil
function RailAtPoint(P: TWinControl; const Pt: TPoint): TjanRail;
var
  i: Integer;
  R: TjanRail;
begin
  Result := nil;
  if P = nil then Exit;
  for i := 0 to P.ControlCount - 1 do
    if (P.Controls[i] is TjanRail) and P.Controls[i].Visible then
    begin
      R := TjanRail(P.Controls[i]);
      if (Abs(Pt.X - R.LineX) <= RailWireTol) and
         (Pt.Y >= R.SpanTop) and (Pt.Y <= R.SpanBottom) then
        Exit(R);
    end;
end;

function NearPoint(const A, B: TPoint): Boolean;
begin
  Result := (Abs(A.X - B.X) <= RailWireTol) and (Abs(A.Y - B.Y) <= RailWireTol);
end;

// ligt Pt op het voedingsbolletje van C, bij welke tekenwijze ook? (een
// paneel kan bewaard zijn met Afbeelding en geopend met IEC, of omgekeerd)
function OnPowerDot(C: TControl; APlusSide: Boolean; const Pt: TPoint): Boolean;
var
  S: TjanSymbolen;
begin
  for S := Low(TjanSymbolen) to High(TjanSymbolen) do
    if NearPoint(Pt, PowerDotSym(C, APlusSide, S)) then
      Exit(True);
  Result := False;
end;

// de rail (+ of -) die met een draad op het voedingsbolletje van C zit
function WiredRail(C: TControl; APlusSide: Boolean): TjanRail;
var
  i: Integer;
  A, B, Dot: TPoint;
  P: TWinControl;
  R: TjanRail;
begin
  Result := nil;
  P := C.Parent;
  if P = nil then Exit;
  for i := 0 to P.ControlCount - 1 do
    if (P.Controls[i] is TjanConnector) and P.Controls[i].Visible then
    begin
      TjanConnector(P.Controls[i]).EndCenters(A, B);
      R := nil;
      if OnPowerDot(C, APlusSide, B) then
        R := RailAtPoint(P, A)
      else if OnPowerDot(C, APlusSide, A) then
        R := RailAtPoint(P, B);
      if (R <> nil) and (R.Plus = APlusSide) then
        Exit(R);
    end;
end;

// ligt Pt op het voedingsbolletje van een component?
function PowerDotAt(P: TWinControl; const Pt: TPoint): Boolean;
var
  i: Integer;
  C: TControl;
begin
  Result := False;
  if P = nil then Exit;
  for i := 0 to P.ControlCount - 1 do
  begin
    C := P.Controls[i];
    if not C.Visible then Continue;
    // (R1 van het schakelrelais niet: een draad van de + rail naar R1 is
    // een gewone ingangsdraad met de spanning van de rail)
    if IsRailInput(C) and OnPowerDot(C, True, Pt) then
      Exit(True);
    if (IsRailOutput(C) or (C is TjanMeter)) and OnPowerDot(C, False, Pt) then
      Exit(True);
  end;
end;

// Voedingsdraden laten eindigen op het bolletje van de huidige tekenwijze
// (na omschakelen Afbeelding <-> IEC/ANSI, en na het laden van een paneel)
procedure RealignPowerWires(P: TWinControl);
var
  i, k: Integer;
  Con: TjanConnector;
  A, B, Dot: TPoint;
  R: TjanRail;
  C: TControl;
  RailAtStart: Boolean;
begin
  if P = nil then Exit;
  for i := 0 to P.ControlCount - 1 do
  begin
    if not (P.Controls[i] is TjanConnector) then Continue;
    Con := TjanConnector(P.Controls[i]);
    Con.EndCenters(A, B);
    R := RailAtPoint(P, A);
    RailAtStart := R <> nil;
    if not RailAtStart then
      R := RailAtPoint(P, B);
    if R = nil then Continue;
    for k := 0 to P.ControlCount - 1 do
    begin
      C := P.Controls[k];
      if not C.Visible then Continue;
      if not ((R.Plus and IsRailInput(C)) or
              ((not R.Plus) and (IsRailOutput(C) or (C is TjanMeter)))) then Continue;
      Dot := PowerDot(C, R.Plus);
      if RailAtStart then
      begin
        if OnPowerDot(C, R.Plus, B) then
        begin
          if not NearPoint(B, Dot) then Con.PlaceEnds(A, Dot);
          Break;
        end;
      end
      else if OnPowerDot(C, R.Plus, A) then
      begin
        if not NearPoint(A, Dot) then Con.PlaceEnds(Dot, B);
        Break;
      end;
    end;
  end;
end;

// zou C met linkerkant ALeft en bovenkant ATop op rail R ingeplugd zijn?
// Invoer zit rechts van een + rail, uitvoer links van een - rail. De
// voltmeter kan beide: + (links) op een + rail, - (rechts) op een - rail.
function RailFits(R: TjanRail; C: TControl; ALeft, ATop: Integer): Boolean;
var
  Y: Integer;
  OnPlus, OnMin: Boolean;
begin
  Result := False;
  Y := ATop + C.Height div 2;
  if (Y < R.SpanTop) or (Y > R.SpanBottom) then Exit;
  OnPlus := ALeft = R.LineX + RailGap;
  OnMin := ALeft + C.Width + RailGap = R.LineX;
  if C is TjanSchakelRelais then
    // links een + rail (R1, contact), rechts een - rail (R-, spoel)
    Result := (R.Plus and OnPlus) or ((not R.Plus) and OnMin)
  else   if IsRailInput(C) then
    Result := R.Plus and OnPlus
  else if IsRailOutput(C) then
    Result := (not R.Plus) and OnMin
  else if C is TjanMeter then
    Result := (R.Plus and OnPlus) or ((not R.Plus) and OnMin);
end;

function RailOf(C: TControl): TjanRail;
var
  i: Integer;
  P: TWinControl;
begin
  Result := nil;
  if (C = nil) or not (IsRailInput(C) or IsRailOutput(C)) then Exit;
  P := C.Parent;
  if P = nil then Exit;
  for i := 0 to P.ControlCount - 1 do
    if (P.Controls[i] is TjanRail) and P.Controls[i].Visible and
       RailFits(TjanRail(P.Controls[i]), C, C.Left, C.Top) and
       (not ((C is TjanSchakelRelais) and TjanRail(P.Controls[i]).Plus)) then
      Exit(TjanRail(P.Controls[i]));
  // niet ingeplugd: misschien met een voedingsdraad aangesloten
  Result := WiredRail(C, IsRailInput(C));
end;

// schakelrelais: de + rail links, waarop R1 (het contact) is ingeplugd
function SchakelPlusRail(C: TControl): TjanRail;
var
  i: Integer;
  P: TWinControl;
begin
  Result := nil;
  P := C.Parent;
  if P = nil then Exit;
  for i := 0 to P.ControlCount - 1 do
    if (P.Controls[i] is TjanRail) and P.Controls[i].Visible and
       TjanRail(P.Controls[i]).Plus and
       RailFits(TjanRail(P.Controls[i]), C, C.Left, C.Top) then
      Exit(TjanRail(P.Controls[i]));
  Result := WiredRail(C, True);
end;

function RailPlugged(C: TControl): Boolean;
begin
  Result := RailOf(C) <> nil;
end;

function RailOK(C: TControl): Boolean;
var
  R: TjanRail;
begin
  Result := True;
  if not (IsRailInput(C) or IsRailOutput(C)) then Exit;
  if not PanelHasRails(C.Parent) then Exit;
  R := RailOf(C);
  if R = nil then
    Result := False
  else if IsRailInput(C) then
    Result := R.Powered
  else
    // uitvoer: alleen als de bron de + rail(s) voedt
    Result := SupplyOK(C.Parent);
end;

// spanning (volt) die invoer C op zijn draad zet: zonder rails 5 V als hij
// aan staat, met rails de spanning van zijn + rail (0 V als hij los staat)
function SignalVolt(C: TControl; Raw: Boolean): Double;
var
  R: TjanRail;
begin
  Result := 0;
  if not Raw then Exit;
  if not PanelHasRails(C.Parent) then Exit(RailMaxVolt);
  R := RailOf(C);
  if (R <> nil) and R.Plus then
    Result := R.Volt;
end;

procedure SnapToRail(C: TControl; var NewLeft: Integer; Tol: Integer);
var
  i, Want, D, Best, BestWant, Y: Integer;
  P: TWinControl;
  R: TjanRail;
  CanPlus, CanMin: Boolean;
begin
  CanPlus := IsRailInput(C) or (C is TjanMeter) or (C is TjanSchakelRelais);
  CanMin := IsRailOutput(C) or (C is TjanMeter);
  if not (CanPlus or CanMin) then Exit;
  P := C.Parent;
  if not PanelHasRails(P) then Exit;
  Best := Tol + 1;
  BestWant := NewLeft;
  Y := C.Top + C.Height div 2;
  for i := 0 to P.ControlCount - 1 do
  begin
    if not (P.Controls[i] is TjanRail) then Continue;
    R := TjanRail(P.Controls[i]);
    if not R.Visible then Continue;
    if (R.Plus and not CanPlus) or ((not R.Plus) and not CanMin) then Continue;
    if (Y < R.SpanTop) or (Y > R.SpanBottom) then Continue;  // boven of onder de rail
    if R.Plus then
      Want := R.LineX + RailGap
    else
      Want := R.LineX - RailGap - C.Width;
    D := Abs(NewLeft - Want);
    if D < Best then
    begin
      Best := D;
      BestWant := Want;
    end;
  end;
  if Best <= Tol then
    NewLeft := BestWant;
  P.Invalidate;   // stekkers en bolletjes bijwerken
end;

// Per ingeplugd component: een stekker (1 px) van de rail naar het
// component met een bolletje (7 px) tegen het component. Niet ingeplugde
// invoer en uitvoer krijgen een grijs bolletje: zij werken niet.
procedure DrawRailOverlay(Grid: TjanGridS);

  procedure Plug(R: TjanRail; C: TControl; APlusSide: Boolean);
  var
    Y, DotX: Integer;
    Dot: TPoint;
  begin
    Dot := PowerDot(C, APlusSide);
    DotX := Dot.X;
    Y := Dot.Y;
    if R <> nil then
    begin
      Grid.Canvas.Pen.Color := R.RailColor;
      // stekker alleen als het component echt ingeplugd is (met een
      // voedingsdraad loopt de draad al naar het bolletje)
      if RailFits(R, C, C.Left, C.Top) then
      begin
        if APlusSide then
          Grid.Canvas.MoveTo(R.LineX + 2, Y)
        else
          Grid.Canvas.MoveTo(R.LineX - 1, Y);
        Grid.Canvas.LineTo(DotX, Y);
      end;
      Grid.Canvas.Brush.Color := R.RailColor;
    end
    else
    begin
      Grid.Canvas.Pen.Color := clGray;
      Grid.Canvas.Brush.Color := clSilver;
    end;
    Grid.Canvas.Ellipse(DotX - 3, Y - 3, DotX + 4, Y + 4);
  end;

var
  i, k: Integer;
  C: TControl;
  MinPlugged: Boolean;
begin
  if not PanelHasRails(Grid) then Exit;
  Grid.Canvas.Pen.Width := 1;
  Grid.Canvas.Pen.Style := psSolid;
  Grid.Canvas.Brush.Style := bsSolid;
  for i := 0 to Grid.ControlCount - 1 do
  begin
    C := Grid.Controls[i];
    if not C.Visible then Continue;
    if C is TjanSchakelRelais then
    begin
      Plug(RailOf(C), C, False);                         // R- (spoel)
      if SchakelPlusRail(C) <> nil then
        Plug(SchakelPlusRail(C), C, True);               // R1 (contact)
    end
    else     if IsRailInput(C) then
      Plug(RailOf(C), C, True)
    else if IsRailOutput(C) then
      Plug(RailOf(C), C, False)
    else if C is TjanMeter then
    begin
      // voltmeter: de kanten die echt op een rail zitten
      MinPlugged := False;
      for k := 0 to Grid.ControlCount - 1 do
        if (Grid.Controls[k] is TjanRail) and Grid.Controls[k].Visible and
           RailFits(TjanRail(Grid.Controls[k]), C, C.Left, C.Top) then
        begin
          Plug(TjanRail(Grid.Controls[k]), C, TjanRail(Grid.Controls[k]).Plus);
          if not TjanRail(Grid.Controls[k]).Plus then
            MinPlugged := True;
        end;
      // de - kant: met een draad aan een - rail (blauw), anders grijs
      if not MinPlugged then
        Plug(WiredRail(C, False), C, False);
    end;
  end;
end;

// regel in het paneelbestand: TjanRail;height;left;top;width;+ of -;spanning x10;
function RailFileLine(R: TjanRail): string;
var
  Sign: string;
begin
  if R.Plus then Sign := '+' else Sign := '-';
  Result := Format('TjanRail;%d;%d;%d;%d;%s;%d;',
    [R.Height, R.Left, R.Top, R.Width, Sign, Round(R.SavedVolt * 10)]);
end;

{ TjanRail }

const
  RailVolts: array[0..6] of Double = (0, 1, 2, 3, 3.3, 4, 5);

constructor TjanRail.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  FPlus := True;
  FVolt := RailMaxVolt;
  FTaal := 'NL';
  Width := RailWidth;
  Height := 200;
  HelpKeyword := 'voeding';   // F1: help over voeding & voltmeter
  ShowHint := True;
end;

destructor TjanRail.Destroy;
begin
  FreeAndNil(FMover);
  ElektronLijst(Self, False);
  inherited Destroy;
end;

procedure TjanRail.SetElektronen(const AY: array of Integer; const AI: array of Double);
var
  k: Integer;
  Aan, WasAan: Boolean;
begin
  WasAan := False;
  for k := 0 to High(FElekI) do
    if Abs(FElekI[k]) > ElektronMinA then WasAan := True;
  SetLength(FElekY, Length(AY));
  for k := 0 to High(AY) do FElekY[k] := AY[k];
  SetLength(FElekI, Length(AI));
  Aan := False;
  for k := 0 to High(AI) do
  begin
    FElekI[k] := AI[k];
    if Abs(AI[k]) > ElektronMinA then Aan := True;
  end;
  if Aan <> WasAan then
  begin
    ElektronLijst(Self, Aan);
    Invalidate;
  end;
end;

procedure TjanRail.InvalidateElektronen;
var
  R: TRect;
begin
  if (Parent = nil) or not Parent.HandleAllocated or (Length(FElekY) < 2) then Exit;
  R := Rect(LineX - 4, FElekY[0] - 4, LineX + 6, FElekY[High(FElekY)] + 5);
  InvalidateRect(Parent.Handle, @R, False);
end;

procedure TjanRail.PaintElektronen;
var
  k, X, Y, Y1, Y2: Integer;
  S: Double;
begin
  X := RailLineOfs;
  with Canvas do
  begin
    Pen.Width := 1;
    Pen.Color := RGBToColor(31, 95, 191);
    Brush.Style := bsSolid;
    Brush.Color := RGBToColor(31, 95, 191);
    for k := 0 to High(FElekI) do
    begin
      if (k + 1 > High(FElekY)) or (Abs(FElekI[k]) <= ElektronMinA) then Continue;
      Y1 := FElekY[k] - Top;
      Y2 := FElekY[k + 1] - Top;
      S := ElektronFase(FElekI[k]);
      while Y1 + S < Y2 do
      begin
        Y := Y1 + Round(S);
        Ellipse(X - 2, Y - 2, X + 4, Y + 4);
        S := S + ElektronAfstand;
      end;
    end;
  end;
end;

function TjanRail.GetLineX: Integer;
begin
  Result := Left + RailLineOfs;
end;

function TjanRail.GetSpanTop: Integer;
begin
  Result := Top + RailLabelH;
end;

function TjanRail.GetSpanBottom: Integer;
begin
  Result := Top + Height - 1;
  if not FPlus then
    Dec(Result, RailFootH);   // onderaan staat het massasymbool
end;

function TjanRail.Powered: Boolean;
begin
  Result := FPlus and (Volt >= RailMinVolt - 0.001);
end;

// + rail: de spanning van de bron (zie UpdateSupply); - rail: 0 V
function TjanRail.GetVolt: Double;
begin
  if FPlus then Result := FCalcVolt else Result := 0;
end;

// - rail blauw; + rail grijs bij 0 V, daarboven rood en feller naarmate de
// spanning hoger is
function TjanRail.RailColor: TColor;
begin
  if not FPlus then
    Result := clBlue
  else if Volt <= 0.001 then
    Result := clGray
  else
    Result := RGBToColor(110 + Round(145 * Volt / BronMaxVolt), 0, 0);
end;

procedure TjanRail.SetPlus(const Value: Boolean);
begin
  if FPlus = Value then Exit;
  FPlus := Value;
  UpdateHintText;
  Invalidate;
  if Assigned(Parent) then Parent.Invalidate;
end;

procedure TjanRail.SetVolt(const Value: Double);
var
  V: Double;
begin
  V := Value;
  if V < 0 then V := 0;
  if V > BronMaxVolt then V := BronMaxVolt;
  if Abs(V - FVolt) < 0.001 then Exit;
  FVolt := V;
  UpdateHintText;
  Invalidate;
  if Assigned(Parent) then Parent.Invalidate;   // kleur van de stekkers
end;

procedure TjanRail.SetTaal(const Value: string);
begin
  FTaal := Value;
  UpdateHintText;
end;

procedure TjanRail.UpdateHintText;
var
  V: string;
begin
  V := FormatFloat('0.0', Volt) + ' V';
  if FPlus then
    Hint := Tr(FTaal, '+ rail (voeding):', '+ rail (supply):', 'Rail + (alimentation) :',
        '+ Schiene (Versorgung):') + ' ' + V + #13#10 +
      Tr(FTaal,
        'Invoer rechts op de rail inpluggen. Onder 2V geen signaal.' + #13#10 +
          'De spanning komt van de bron (accu). Sleep de uiteinden om te verlengen.',
        'Plug inputs in on the right of the rail. Below 2V no signal.' + #13#10 +
          'The voltage comes from the source (battery). Drag the ends to resize.',
        'Branchez les entrées à droite du rail. Sous 2V pas de signal.' + #13#10 +
          'La tension vient de la source (batterie). Faites glisser les extrémités.',
        'Eingänge rechts an die Schiene stecken. Unter 2V kein Signal.' + #13#10 +
          'Die Spannung kommt von der Quelle (Akku). Enden ziehen zum Verlängern.')
  else
    Hint := Tr(FTaal,
      '- rail (massa)' + #13#10 + 'Uitvoer links op de rail inpluggen.' + #13#10 +
        'Sleep de uiteinden om te verlengen.',
      '- rail (ground)' + #13#10 + 'Plug outputs in on the left of the rail.' + #13#10 +
        'Drag the ends to resize.',
      'Rail - (masse)' + #13#10 + 'Branchez les sorties à gauche du rail.' + #13#10 +
        'Faites glisser les extrémités pour redimensionner.',
      '- Schiene (Masse)' + #13#10 + 'Ausgänge links an die Schiene stecken.' + #13#10 +
        'Enden ziehen zum Verlängern.');
end;

procedure TjanRail.SendStatusToBar;
begin
  if not Assigned(FOnStatus) then Exit;
  if FPlus then
  begin
    FOnStatus(Self, Tr(FTaal, '+ rail', '+ rail', 'Rail +', '+ Schiene') + ' > ', 0);
    FOnStatus(Self, 'U = ' + FormatFloat('0.0', Volt) + ' V', 1);
  end
  else
  begin
    FOnStatus(Self, Tr(FTaal, '- rail', '- rail', 'Rail -', '- Schiene') + ' > ', 0);
    FOnStatus(Self, Tr(FTaal, 'Massa', 'Ground', 'Masse', 'Masse'), 1);
  end;
  FOnStatus(Self, Format('X=%d Y=%d', [Left, Top]), 2);
end;

procedure TjanRail.CMMouseEnter(var Msg: TMessage);
begin
  inherited;
  UpdateHintText;
  SendStatusToBar;
end;

procedure TjanRail.CMMouseLeave(var Msg: TMessage);
begin
  inherited;
  if FDragMode = 0 then
    Cursor := crDefault;
  if Assigned(FOnStatus) then
  begin
    FOnStatus(Self, '', 0);
    FOnStatus(Self, '', 1);
    FOnStatus(Self, '', 2);
    FOnStatus(Self, '', 3);
  end;
end;

procedure TjanRail.Paint;
var
  X, T, B, TW: Integer;
  Col: TColor;
  S: string;
begin
  X := RailLineOfs;
  T := RailLabelH;
  B := Height;
  Col := RailColor;
  with Canvas do
  begin
    Brush.Style := bsSolid;
    Brush.Color := Col;
    // dopje bovenaan: daar kun je de rail langer of korter slepen
    FillRect(Rect(X - 3, T, X + 5, T + 2));
    if FPlus then
    begin
      FillRect(Rect(X, T, X + 2, B));
      FillRect(Rect(X - 3, B - 2, X + 5, B));     // dopje onderaan
    end
    else
    begin
      // - rail: onderaan het massasymbool, drie streepjes naar beneden
      FillRect(Rect(X, T, X + 2, B - RailFootH + 2));
      FillRect(Rect(X - 6, B - RailFootH + 1, X + 8, B - RailFootH + 3));
      FillRect(Rect(X - 4, B - RailFootH + 5, X + 6, B - RailFootH + 7));
      FillRect(Rect(X - 2, B - RailFootH + 9, X + 4, B - RailFootH + 11));
    end;
    // spanning bovenaan (+ rail: ingestelde spanning, - rail: 0V)
    if FPlus then
      S := FormatFloat('0.#', Volt) + 'V'
    else
      S := '0V';
    Brush.Style := bsClear;
    Font.Name := 'Arial';
    Font.Size := 7;
    Font.Style := [fsBold];
    Font.Color := Col;
    TW := TextWidth(S);
    TextOut((Self.Width - TW) div 2, 0, S);
    if FSelected then
    begin
      Brush.Style := bsClear;
      Pen.Color := clRed;
      Pen.Style := psDot;
      Pen.Width := 1;
      Rectangle(ClientRect);
      Pen.Style := psSolid;
    end;
    Brush.Style := bsSolid;
  end;
  PaintElektronen;
end;

// 1 = verplaatsen, 2 = bovenkant, 3 = onderkant
function TjanRail.HitMode(Y: Integer): Integer;
begin
  if Y <= RailLabelH + RailGrip then
    Result := 2
  else if (FPlus and (Y >= Height - RailGrip)) or
          ((not FPlus) and (Y >= Height - RailFootH - RailGrip)) then
    Result := 3
  else
    Result := 1;
end;

procedure TjanRail.BuildPopup;
var
  mi: TMenuItem;
begin
  if not Assigned(PopupMenu) then
    PopupMenu := TPopupMenu.Create(Self)
  else
    PopupMenu.Items.Clear;
  // (de spanning van een + rail komt van de bron: geen menu Spanning meer)

  mi := TMenuItem.Create(PopupMenu);
  if FLock then
    mi.Caption := Tr(FTaal, 'Ontgrendel', 'Unlock', 'Déverrouiller', 'Entsperren')
  else
    mi.Caption := Tr(FTaal, 'Vergrendel', 'Lock', 'Verrouiller', 'Sperren');
  mi.OnClick := LockClick;
  PopupMenu.Items.Add(mi);

  mi := TMenuItem.Create(PopupMenu);
  if FSelected then
    mi.Caption := Tr(FTaal, 'Deselecteer object', 'Deselect object', 'Désélectionner l''objet', 'Objekt abwählen')
  else
    mi.Caption := Tr(FTaal, 'Selecteer object', 'Select object', 'Sélectionner un objet', 'Objekt auswählen');
  mi.OnClick := SelectClick;
  PopupMenu.Items.Add(mi);
end;

procedure TjanRail.VoltClick(Sender: TObject);
begin
  Volt := RailVolts[TMenuItem(Sender).Tag];
  SendStatusToBar;
end;

procedure TjanRail.LockClick(Sender: TObject);
begin
  FLock := not FLock;
end;

procedure TjanRail.SelectClick(Sender: TObject);
begin
  if Assigned(FBox) then
    FBox.SelectObject(Self);
end;

procedure TjanRail.MouseDown(Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
var
  P: TPoint;
  Con: TjanConnector;
begin
  inherited MouseDown(Button, Shift, X, Y);
  if Parent = nil then Exit;
  if (Button = mbRight) and not FLock then
  begin
    BuildPopup;
    P := Mouse.CursorPos;
    PopupMenu.PopUp(P.X, P.Y);
    Exit;
  end;
  // met de knop Verbinding: een voedingsdraad vanaf de rail beginnen
  if (Button = mbLeft) and (Screen.Cursor = crDraad) then
  begin
    P := Parent.ScreenToClient(ClientToScreen(Point(X, Y)));
    if (P.Y >= SpanTop) and (P.Y <= SpanBottom) then
    begin
      FDragMode := 0;
      if FPlus then
      begin
        // het begin van de draad (midden van het blokje) precies op de lijn;
        // de draad wijst naar rechts, naar de invoer
        Maakdraad(P.Y - 4, LineX - 4, Parent);
        movecursor;
      end
      else
      begin
        // - rail: de uitvoer staat links, dus de draad wijst naar links
        Con := TjanConnector.Create(Parent);
        Con.Parent := Parent;
        Con.SetBounds(LineX - 4, P.Y - 4, 35, 25);
        Con.Tag := Parent.ControlCount;
        Con.PlaceEnds(Point(LineX, P.Y), Point(LineX - 30, P.Y + 16));
        Con.Visible := True;
        Con.BringToFront;
        // muisaanwijzer op het einde, zoals bij movecursor
        Application.ProcessMessages;
        Mouse.CursorPos := Parent.ClientToScreen(Point(LineX - 30, P.Y + 16));
      end;
    end;
    Exit;
  end;
  if (Button <> mbLeft) or FLock then Exit;
  FDragStart := Parent.ScreenToClient(ClientToScreen(Point(X, Y)));
  FStartRect := BoundsRect;
  FDragMode := HitMode(Y);
  if FDragMode = 1 then
  begin
    // ingeplugde componenten (met hun draden) schuiven mee
    FreeAndNil(FMover);
    FMover := TjanGroupSelect.Create(nil);
    TjanGroupSelect(FMover).Parent := Parent;
    TjanGroupSelect(FMover).BeginRailMove(Self);
  end;
end;

procedure TjanRail.MouseMove(Shift: TShiftState; X, Y: Integer);
var
  P, Snapped: TPoint;
  DX, DY, NewTop, NewBottom: Integer;
  WorkR: TRect;
begin
  inherited MouseMove(Shift, X, Y);
  if Parent = nil then Exit;
  if FDragMode = 0 then
  begin
    // met de knop Verbinding: het pen-symbool houden (onder GTK2 wint de
    // cursor van het besturingselement van Screen.Cursor)
    if Screen.Cursor = crDraad then
      Cursor := crDraad
    else if FLock then
      Cursor := crDefault
    else if HitMode(Y) = 1 then
      Cursor := crSizeAll
    else
      Cursor := crSizeNS;
    Exit;
  end;
  if not (ssLeft in Shift) then Exit;

  P := Parent.ScreenToClient(ClientToScreen(Point(X, Y)));
  DX := P.X - FDragStart.X;
  DY := P.Y - FDragStart.Y;
  if Parent is TjanGridS then
    WorkR := TjanGridS(Parent).GetWorkAreaRect
  else
    WorkR := Parent.ClientRect;

  case FDragMode of
    1:
      begin
        // lijn en bovenkant van de rail op het raster laten springen
        if Parent is TjanGridS then
        begin
          Snapped := TjanGridS(Parent).SnapPointToRuler(
            Point(FStartRect.Left + RailLineOfs + DX, FStartRect.Top + RailLabelH + DY), WorkR);
          DX := Snapped.X - (FStartRect.Left + RailLineOfs);
          DY := Snapped.Y - (FStartRect.Top + RailLabelH);
        end;
        if FStartRect.Left + DX < WorkR.Left then DX := WorkR.Left - FStartRect.Left;
        if FStartRect.Top + DY < WorkR.Top then DY := WorkR.Top - FStartRect.Top;
        SetBounds(FStartRect.Left + DX, FStartRect.Top + DY, Width, Height);
        if Assigned(FMover) then
          TjanGroupSelect(FMover).RailMove(DX, DY);
      end;
    2:
      begin
        NewTop := FStartRect.Top + DY;
        if NewTop < WorkR.Top then NewTop := WorkR.Top;
        if FStartRect.Bottom - NewTop < RailLabelH + RailMinLen + RailFootH then
          NewTop := FStartRect.Bottom - RailLabelH - RailMinLen - RailFootH;
        SetBounds(Left, NewTop, Width, FStartRect.Bottom - NewTop);
      end;
    3:
      begin
        NewBottom := FStartRect.Bottom + DY;
        if NewBottom > WorkR.Bottom then NewBottom := WorkR.Bottom;
        if NewBottom - FStartRect.Top < RailLabelH + RailMinLen + RailFootH then
          NewBottom := FStartRect.Top + RailLabelH + RailMinLen + RailFootH;
        SetBounds(Left, FStartRect.Top, Width, NewBottom - FStartRect.Top);
      end;
  end;
  SendStatusToBar;
end;

procedure TjanRail.MouseUp(Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
begin
  inherited MouseUp(Button, Shift, X, Y);
  if Assigned(FMover) then
  begin
    TjanGroupSelect(FMover).EndRailMove;
    FreeAndNil(FMover);
  end;
  FDragMode := 0;
  if Assigned(Parent) then
    Parent.Invalidate;
end;

// ============================================================
// Voedingskring: bron (accu), zekering en milliampèremeter
// ============================================================
//
// De kring: + van de bron -> (zekering, meter ...) -> + rail, en - rail ->
// - van de bron. Alle verbruikers die aan staan vormen samen de belasting
// (een weerstand per onderdeel, zie LoadAmps). UpdateSupply rekent met de
// wet van Ohm de stroom en de spanning op de rail uit:
//   I = E / (Ri + Rbelasting)    U(rail) = E - I * Ri
// Zonder gesloten kring (geen bron, - niet aangesloten, zekering
// doorgebrand) staat de + rail op 0 V.

const
  BronRi: array[0..3] of Double = (0, 0.5, 1, 2);            // ohm
  ZekeringMA: array[0..4] of Integer = (100, 250, 500, 1000, 2000);
  VoedingPinTol = 5;      // zo dicht bij een klem telt een draadeinde
  BronW = 112; BronH = 84;
  ZekeringW = 40; ZekeringH = 58;
  AmpMeterW = 100; AmpMeterH = 51;
  // weerstand/contact: goed contact, lange dunne draad, slecht contact,
  // verbrand contact
  WeerstandOhm: array[0..3] of Double = (0.05, 1, 2, 10);
  WeerstandW = 100; WeerstandH = 42;
  // onderdelen met twee klemmen voor serie en parallel
  // lampen voor 12 V: 6 W, 3 W, 2,4 W, 1,2 W, 0,6 W, 0,3 W
  Lamp2Ohm: array[0..5] of Double = (24, 48, 60, 120, 240, 480);
  Lamp2Standaard = 3;     // 120 ohm: 100 mA bij 12 V
  Lamp2W = 64; Lamp2H = 46;
  Schakelaar2W = 64; Schakelaar2H = 40;
  Voltmeter2W = 100; Voltmeter2H = 51;

// naam van soort I van de weerstand (zie WeerstandOhm)
function WeerstandNaam(const ATaal: string; I: Integer): string;
begin
  case I of
    0: Result := Tr(ATaal, 'goed contact', 'good contact', 'bon contact', 'guter Kontakt');
    1: Result := Tr(ATaal, 'lange dunne draad', 'long thin wire', 'long fil fin', 'langer dünner Draht');
    2: Result := Tr(ATaal, 'slecht contact', 'poor contact', 'mauvais contact', 'schlechter Kontakt');
  else
    Result := Tr(ATaal, 'verbrand contact', 'burnt contact', 'contact brûlé', 'verbrannter Kontakt');
  end;
end;

function OhmText(R: Double): string;
begin
  if R = 0 then Result := '0'
  else if R < 1 then Result := FormatFloat('0.00', R) else Result := FormatFloat('0', R);
  Result := Result + ' Ω';
end;

// getallen voor de berekeningen in de hints (wet van Ohm)
function AmpText(I: Double): string;
begin
  Result := FormatFloat('0.000', I) + ' A';
end;

function MilliAmpText(I: Double): string;
begin
  Result := FormatFloat('0', I * 1000) + ' mA';
end;

function VoltText(U: Double): string;
begin
  if U >= 10 then Result := FormatFloat('0.0', U)
  else if U >= 0.1 then Result := FormatFloat('0.00', U)
  else Result := FormatFloat('0.000', U);
  Result := Result + ' V';
end;

function WattText(P: Double): string;
begin
  if P >= 10 then Result := FormatFloat('0.0', P)
  else if P >= 0.1 then Result := FormatFloat('0.00', P)
  else Result := FormatFloat('0.000', P);
  Result := Result + ' W';
end;

// "I = 242 mA = 0,242 A"
function StroomRegel(I: Double): string;
begin
  Result := 'I = ' + MilliAmpText(I) + ' = ' + AmpText(I);
end;

// "P = U × I = 2,42 V × 0,242 A = 0,59 W"
function VermogenRegel(U, I: Double): string;
begin
  Result := 'P = U × I = ' + VoltText(U) + ' × ' + AmpText(I) + ' = ' + WattText(U * I);
end;

// hoogste spanning op een + rail van paneel P (0 als er geen is)
function MaxRailVolt(P: TWinControl): Double;
var
  i: Integer;
begin
  Result := 0;
  if P = nil then Exit;
  for i := 0 to P.ControlCount - 1 do
    if (P.Controls[i] is TjanRail) and P.Controls[i].Visible and
       (TjanRail(P.Controls[i]).Volt > Result) then
      Result := TjanRail(P.Controls[i]).Volt;
end;

// stroom (A) die verbruiker C bij 12 V trekt als hij aan staat; 0 als hij
// uit staat of niet aangesloten is. Bij een andere spanning evenredig
// (wet van Ohm: elke verbruiker is een vaste weerstand).
function LoadAmps12(C: TControl): Double;
const
  Segments: array[0..15] of Integer = (6, 2, 5, 5, 4, 5, 6, 3, 7, 6, 6, 5, 4, 5, 5, 4);
var
  i: Integer;
  P: TjanSimPersoon;
begin
  Result := 0;
  if not C.Visible then Exit;
  // uitvoer werkt alleen ingeplugd op (of met een draad aan) de - rail
  if IsRailOutput(C) and (RailOf(C) = nil) then Exit;
  if C is TjanSimLight then
  begin
    if TjanSimLight(C).Lit then
      if TjanSimLight(C).Kleur = lkLamp then Result := 0.100 else Result := 0.020;
  end
  else if C is TjanSchakelRelais then
  begin
    if TjanSchakelRelais(C).Lit then Result := 0.040;
  end
  else if C is TjanSimRelais then
  begin
    if TjanSimRelais(C).Lit then Result := 0.040;
  end
  else if C is TjanSimBuzzer then
  begin
    if TjanSimBuzzer(C).Lit then Result := 0.030;
  end
  else if C is TjanSimMotor then
  begin
    if TjanSimMotor(C).Inputs[0] <> TjanSimMotor(C).Inputs[1] then Result := 0.200;
  end
  else if C is TjanDisplay then
    Result := 0.010 * Segments[TjanDisplay(C).Bits and 15]
  else if C is TjanSimPersoon then
  begin
    P := TjanSimPersoon(C);
    for i := 0 to P.InputCount - 1 do
      if P.Inputs[i] then Result := Result + 0.020;
  end
  // poorten, tellers, geheugen en ingeplugde invoer: een klein beetje
  else if (IsRailInput(C) and (RailOf(C) <> nil)) or (C is TjanLogic) or
          (C is TjanTeller) or (C is TjanMemory) or (C is TjanSimStappenteller) or
          (C is TjanLogicRun) then
    Result := 0.001;
end;

// helderheid (0..1) van een lamp of led: spanning van de voeding / 12 V;
// zonder rails op het paneel altijd vol
function LampHelderheid(C: TControl): Double;
var
  i: Integer;
  U: Double;
begin
  Result := 1;
  if (C.Parent = nil) or not PanelHasRails(C.Parent) then Exit;
  U := 0;
  for i := 0 to C.Parent.ControlCount - 1 do
    if (C.Parent.Controls[i] is TjanRail) and C.Parent.Controls[i].Visible and
       (TjanRail(C.Parent.Controls[i]).Volt > U) then
      U := TjanRail(C.Parent.Controls[i]).Volt;
  Result := U / BronMaxVolt;
  if Result > 1 then Result := 1;
  if Result < 0.15 then Result := 0.15;
end;

// staat er een + rail onder spanning op paneel P? (dan werkt de uitvoer)
function SupplyOK(P: TWinControl): Boolean;
var
  i: Integer;
begin
  Result := False;
  if P = nil then Exit;
  for i := 0 to P.ControlCount - 1 do
    if (P.Controls[i] is TjanRail) and P.Controls[i].Visible and
       TjanRail(P.Controls[i]).Powered then
      Exit(True);
end;

// een draad (niet AExclude) met een uiteinde bij Pt; AOther = het andere einde
function WireAt(P: TWinControl; const Pt: TPoint; AExclude: TControl;
  out AOther: TPoint): TjanConnector;
var
  i: Integer;
  A, B: TPoint;
begin
  Result := nil;
  for i := 0 to P.ControlCount - 1 do
    if (P.Controls[i] is TjanConnector) and P.Controls[i].Visible and
       (P.Controls[i] <> AExclude) then
    begin
      TjanConnector(P.Controls[i]).EndCenters(A, B);
      if (Abs(A.X - Pt.X) <= VoedingPinTol) and (Abs(A.Y - Pt.Y) <= VoedingPinTol) then
      begin
        AOther := B;
        Exit(TjanConnector(P.Controls[i]));
      end;
      if (Abs(B.X - Pt.X) <= VoedingPinTol) and (Abs(B.Y - Pt.Y) <= VoedingPinTol) then
      begin
        AOther := A;
        Exit(TjanConnector(P.Controls[i]));
      end;
    end;
end;

// Rekent de voedingskring van paneel P uit als een netwerk (knooppuntmethode,
// wetten van Kirchhoff). Elke klem van een voedingsonderdeel en elke rail is
// een knooppunt; draden voegen knooppunten samen. Takken:
//   bron            E met inwendige weerstand Ri (Norton: stroom E/Ri, geleiding 1/Ri)
//   zekering, mA-meter, gesloten schakelaar: bijna 0 ohm (RKlein)
//   contact, lamp met 2 klemmen: hun weerstand
//   voltmeter met 2 klemmen: geen tak (neemt geen stroom)
//   verbruikers op de rails (lampen, led's, poorten ...): samen geleiding G
//     tussen de + rail en de - rail (zonder - rail: de - klem van de bron)
// Een zekering met te veel stroom smelt; dan wordt opnieuw gerekend.
// Zet de spanning van de rails, de klemspanning en stroom van de bron, en
// de stroom en klemspanningen van de andere onderdelen. AInval: gewijzigde
// onderdelen opnieuw tekenen.
procedure ElektronenRails(P: TWinControl; AU: Double; AToon: Boolean); forward;

procedure UpdateSupply(P: TWinControl; AInval: Boolean);
const
  RKlein = 0.001;   // ohm: zekering, meter, gesloten schakelaar, bron zonder Ri
  GMin = 1E-9;      // siemens naar de massa: houdt losse knooppunten op 0 V
type
  TTak = record
    A, B: Integer;        // knooppunten
    G: Double;            // geleiding (S)
    D: TjanVoedingsDeel;  // onderdeel (nil = verbruikers op de rails)
  end;
var
  Parts: array of TjanVoedingsDeel;
  Rails: array of TjanRail;
  Ouder: array of Integer;          // union-find over klemmen en rails
  NodeOf: array of Integer;         // klem/rail -> knooppunt
  Tak: array of TTak;
  Gm: array of array of Double;     // geleidingsmatrix
  Iv, V: array of Double;           // bronstromen, knooppuntspanningen
  CompGnd: array of Integer;        // massa per samenhangend deel
  NewVolt: array of Double;
  i, k, j, N, NP, NR, A, B, Ronde, PlusR, Mass: Integer;
  C: TControl;
  Con: TjanConnector;
  Pa, Pb: TPoint;
  G, E, Gs, Amp, U, F, Hulp: Double;
  Smelt, Changed: Boolean;
  Z: TjanZekering;
  LoadItA, LoadItB: Integer;       // klem/rail waar de verbruikers aan hangen
  LoadG: Double;
  Toon: Boolean;
  Vraag, Sub: array of Double;     // stroom die een klem/rail uit de draden neemt
  Draad: array of TjanConnector;
  DrA, DrB, Buur, BuurDraad, Volg, OuderIt, OuderDraad: array of Integer;
  BuurStart: array of Integer;
  Gezien: array of Boolean;
  NI, ND, Kop, Staart, m: Integer;

  // weerstand, minstens RKlein (een ideale bron of draad: bijna 0 ohm)
  function NietNul(R: Double): Double;
  begin
    if R < RKlein then Result := RKlein else Result := R;
  end;

  function Find(X: Integer): Integer;
  begin
    while Ouder[X] <> X do
    begin
      Ouder[X] := Ouder[Ouder[X]];
      X := Ouder[X];
    end;
    Result := X;
  end;

  procedure Union(X, Y: Integer);
  begin
    X := Find(X); Y := Find(Y);
    if X <> Y then Ouder[X] := Y;
  end;

  // klem of rail bij punt Pt: index in Ouder, anders -1
  function ItemAt(const Pt: TPoint): Integer;
  var
    q, pn: Integer;
    R: TjanRail;
  begin
    for q := 0 to NP - 1 do
    begin
      pn := Parts[q].PinAt(Pt);
      if pn >= 0 then Exit(2 * q + pn);
    end;
    R := RailAtPoint(P, Pt);
    if R <> nil then
      for q := 0 to NR - 1 do
        if Rails[q] = R then Exit(2 * NP + q);
    Result := -1;
  end;

  procedure AddTak(AA, AB: Integer; AG: Double; AD: TjanVoedingsDeel);
  begin
    SetLength(Tak, Length(Tak) + 1);
    Tak[High(Tak)].A := AA;
    Tak[High(Tak)].B := AB;
    Tak[High(Tak)].G := AG;
    Tak[High(Tak)].D := AD;
  end;

  function PinNode(Q, K: Integer): Integer;
  begin
    Result := NodeOf[2 * Q + K];
  end;

  // Gauss-eliminatie met spilkeuze: Gm * V = Iv
  procedure Solve;
  var
    r, s, t, Best: Integer;
    M, Tmp: Double;
    Row: array of Double;
  begin
    for r := 0 to N - 1 do
    begin
      Best := r;
      for s := r + 1 to N - 1 do
        if Abs(Gm[s][r]) > Abs(Gm[Best][r]) then Best := s;
      if Best <> r then
      begin
        Row := Gm[r]; Gm[r] := Gm[Best]; Gm[Best] := Row;
        Tmp := Iv[r]; Iv[r] := Iv[Best]; Iv[Best] := Tmp;
      end;
      if Abs(Gm[r][r]) < 1E-30 then Continue;
      for s := r + 1 to N - 1 do
      begin
        M := Gm[s][r] / Gm[r][r];
        if M = 0 then Continue;
        for t := r to N - 1 do
          Gm[s][t] := Gm[s][t] - M * Gm[r][t];
        Iv[s] := Iv[s] - M * Iv[r];
      end;
    end;
    for r := N - 1 downto 0 do
    begin
      M := Iv[r];
      for t := r + 1 to N - 1 do
        M := M - Gm[r][t] * V[t];
      if Abs(Gm[r][r]) < 1E-30 then V[r] := 0 else V[r] := M / Gm[r][r];
    end;
  end;

  procedure SetStroom(D: TjanVoedingsDeel; AI: Double);
  begin
    if Abs(D.FAmp - AI) > 0.00005 then
    begin
      D.FAmp := AI;
      if AInval then D.Invalidate;
    end;
    if (D is TjanAmpMeter) and (Abs(TjanAmpMeter(D).FStroom - Abs(AI)) > 0.00005) then
    begin
      TjanAmpMeter(D).FStroom := Abs(AI);
      if AInval then D.Invalidate;
    end
    else if (D is TjanWeerstand) and (Abs(TjanWeerstand(D).FStroom - Abs(AI)) > 0.00005) then
    begin
      TjanWeerstand(D).FStroom := Abs(AI);
      if AInval then D.Invalidate;
    end;
  end;

  procedure SetPinV(D: TjanVoedingsDeel; K: Integer; AV: Double);
  begin
    if Abs(D.FPinV[K] - AV) > 0.0005 then
    begin
      D.FPinV[K] := AV;
      if AInval then D.Invalidate;
    end;
    if D is TjanZekering then
    begin
      if K = 0 then TjanZekering(D).FInVolt := AV else TjanZekering(D).FUitVolt := AV;
    end
    else if D is TjanAmpMeter then
    begin
      if K = 0 then TjanAmpMeter(D).FInVolt := AV else TjanAmpMeter(D).FUitVolt := AV;
    end
    else if D is TjanWeerstand then
    begin
      if K = 0 then TjanWeerstand(D).FInVolt := AV else TjanWeerstand(D).FUitVolt := AV;
    end;
  end;

begin
  if P = nil then Exit;
  // onderdelen, rails en de belasting door de verbruikers op de rails
  NP := 0; NR := 0;
  G := 0;
  SetLength(Parts, 0);
  SetLength(Rails, 0);
  for i := 0 to P.ControlCount - 1 do
  begin
    C := P.Controls[i];
    if not C.Visible then Continue;
    if C is TjanRail then
    begin
      SetLength(Rails, NR + 1);
      Rails[NR] := TjanRail(C);
      Inc(NR);
    end
    else if C is TjanVoedingsDeel then
    begin
      SetLength(Parts, NP + 1);
      Parts[NP] := TjanVoedingsDeel(C);
      Inc(NP);
    end
    else
      G := G + LoadAmps12(C) / BronMaxVolt;
  end;

  // knooppunten: klemmen (2 per onderdeel) en rails, samengevoegd door draden
  SetLength(Ouder, 2 * NP + NR);
  for i := 0 to High(Ouder) do Ouder[i] := i;
  for i := 0 to P.ControlCount - 1 do
    if (P.Controls[i] is TjanConnector) and P.Controls[i].Visible then
    begin
      Con := TjanConnector(P.Controls[i]);
      Con.EndCenters(Pa, Pb);
      A := ItemAt(Pa);
      B := ItemAt(Pb);
      if (A >= 0) and (B >= 0) then Union(A, B);
    end;
  SetLength(NodeOf, Length(Ouder));
  for i := 0 to High(NodeOf) do NodeOf[i] := -1;
  N := 0;
  for i := 0 to High(Ouder) do
  begin
    j := Find(i);
    if NodeOf[j] < 0 then
    begin
      NodeOf[j] := N;
      Inc(N);
    end;
    NodeOf[i] := NodeOf[j];
  end;

  // de rail waar de verbruikers op staan: eerste + rail en eerste - rail
  PlusR := -1; Mass := -1;
  LoadItA := -1; LoadItB := -1; LoadG := 0;
  for k := 0 to NR - 1 do
    if Rails[k].Plus then
    begin
      if PlusR < 0 then
      begin
        PlusR := NodeOf[2 * NP + k];
        LoadItA := 2 * NP + k;
      end;
    end
    else if Mass < 0 then
    begin
      Mass := NodeOf[2 * NP + k];
      LoadItB := 2 * NP + k;
    end;

  SetLength(V, N);
  SetLength(NewVolt, NR);
  for Ronde := 1 to 10 do
  begin
    // takken
    SetLength(Tak, 0);
    for k := 0 to NP - 1 do
    begin
      if Parts[k] is TjanBron then
        AddTak(PinNode(k, 0), PinNode(k, 1), 1 / NietNul(TjanBron(Parts[k]).Ri), Parts[k])
      else if Parts[k] is TjanZekering then
      begin
        if not TjanZekering(Parts[k]).Doorgebrand then
          AddTak(PinNode(k, 0), PinNode(k, 1), 1 / RKlein, Parts[k]);
      end
      else if Parts[k] is TjanAmpMeter then
        AddTak(PinNode(k, 0), PinNode(k, 1), 1 / RKlein, Parts[k])
      else if Parts[k] is TjanWeerstand then
        AddTak(PinNode(k, 0), PinNode(k, 1), 1 / TjanWeerstand(Parts[k]).Ohm, Parts[k])
      else if Parts[k] is TjanLamp2 then
        AddTak(PinNode(k, 0), PinNode(k, 1), 1 / TjanLamp2(Parts[k]).Ohm, Parts[k])
      else if Parts[k] is TjanSchakelaar2 then
      begin
        if TjanSchakelaar2(Parts[k]).Aan then
          AddTak(PinNode(k, 0), PinNode(k, 1), 1 / RKlein, Parts[k]);
      end;
    end;

    // samenhangende delen (alle takken, ook de belasting); per deel is de
    // - klem van de eerste bron de massa (0 V)
    SetLength(Ouder, N);
    for i := 0 to N - 1 do Ouder[i] := i;
    for k := 0 to High(Tak) do Union(Tak[k].A, Tak[k].B);
    // verbruikers: tussen de + rail en de - rail; zonder - rail naar de
    // massa van het deel van de + rail
    j := Mass;
    if (PlusR >= 0) and (j < 0) then
      for k := 0 to NP - 1 do
        if (Parts[k] is TjanBron) and (Find(PinNode(k, 0)) = Find(PlusR)) then
        begin
          j := PinNode(k, 1);
          if Mass < 0 then LoadItB := 2 * k + 1;
          Break;
        end;
    LoadG := 0;
    if (PlusR >= 0) and (j >= 0) and (j <> PlusR) and (G > 0) then
    begin
      LoadG := G;
      AddTak(PlusR, j, G, nil);
      Union(PlusR, j);
    end;
    SetLength(CompGnd, N);
    for i := 0 to N - 1 do CompGnd[i] := -1;
    for k := 0 to NP - 1 do
      if Parts[k] is TjanBron then
      begin
        i := Find(PinNode(k, 1));
        if CompGnd[i] < 0 then CompGnd[i] := PinNode(k, 1);
      end;

    // matrix opbouwen
    SetLength(Gm, N, N);
    SetLength(Iv, N);
    for i := 0 to N - 1 do
    begin
      for j := 0 to N - 1 do Gm[i][j] := 0;
      Gm[i][i] := GMin;
      Iv[i] := 0;
      if CompGnd[Find(i)] = i then Gm[i][i] := Gm[i][i] + 1;   // massa
    end;
    for k := 0 to High(Tak) do
    begin
      A := Tak[k].A; B := Tak[k].B;
      if A = B then Continue;
      Gm[A][A] := Gm[A][A] + Tak[k].G;
      Gm[B][B] := Gm[B][B] + Tak[k].G;
      Gm[A][B] := Gm[A][B] - Tak[k].G;
      Gm[B][A] := Gm[B][A] - Tak[k].G;
      if Tak[k].D is TjanBron then
      begin
        // bronstroom E/Ri van de - klem naar de + klem
        F := TjanBron(Tak[k].D).Volt * Tak[k].G;
        Iv[A] := Iv[A] + F;
        Iv[B] := Iv[B] - F;
      end;
    end;
    Solve;

    // te veel stroom door een zekering: ze smelt, opnieuw rekenen
    Smelt := False;
    for k := 0 to NP - 1 do
      if (Parts[k] is TjanZekering) and not TjanZekering(Parts[k]).Doorgebrand then
      begin
        Z := TjanZekering(Parts[k]);
        Amp := Abs(V[PinNode(k, 0)] - V[PinNode(k, 1)]) / RKlein;
        if Amp > Z.NominaalA + 0.000001 then
        begin
          Z.Doorgebrand := True;
          Smelt := True;
        end;
      end;
    if not Smelt then Break;
  end;

  // resultaten: klemspanningen en stromen van de onderdelen
  for k := 0 to NP - 1 do
  begin
    for j := 0 to 1 do
      if j < Parts[k].PinCount then
        SetPinV(Parts[k], j, V[PinNode(k, j)]);
    A := PinNode(k, 0); B := PinNode(k, 1);
    U := V[A] - V[B];
    if Parts[k] is TjanBron then
    begin
      Gs := 1 / NietNul(TjanBron(Parts[k]).Ri);
      E := TjanBron(Parts[k]).Volt;
      Amp := (E - U) * Gs;
      if Abs(Amp) < 0.00001 then Amp := 0;
      if (Abs(TjanBron(Parts[k]).FKlem - U) > 0.0005) or
         (Abs(TjanBron(Parts[k]).FStroom - Amp) > 0.00005) then
      begin
        TjanBron(Parts[k]).FKlem := U;
        TjanBron(Parts[k]).FStroom := Amp;
        if AInval then Parts[k].Invalidate;
      end;
    end
    else if (Parts[k] is TjanZekering) and TjanZekering(Parts[k]).Doorgebrand then
      SetStroom(Parts[k], 0)
    else if (Parts[k] is TjanZekering) or (Parts[k] is TjanAmpMeter) then
      SetStroom(Parts[k], U / RKlein)
    else if Parts[k] is TjanWeerstand then
      SetStroom(Parts[k], U / TjanWeerstand(Parts[k]).Ohm)
    else if Parts[k] is TjanLamp2 then
      SetStroom(Parts[k], U / TjanLamp2(Parts[k]).Ohm)
    else if (Parts[k] is TjanSchakelaar2) and TjanSchakelaar2(Parts[k]).Aan then
      SetStroom(Parts[k], U / RKlein)
    else
      SetStroom(Parts[k], 0);
  end;

  // de + rails: spanning t.o.v. de - rail (zonder - rail: t.o.v. de massa)
  for k := 0 to NR - 1 do
  begin
    NewVolt[k] := 0;
    if not Rails[k].Plus then Continue;
    i := NodeOf[2 * NP + k];
    if Mass >= 0 then Hulp := V[Mass] else Hulp := 0;
    U := V[i] - Hulp;
    if U < 0.0005 then U := 0;
    NewVolt[k] := U;
  end;

  // nieuwe spanning op de rails
  Changed := False;
  for k := 0 to NR - 1 do
    if Abs(Rails[k].FCalcVolt - NewVolt[k]) > 0.0005 then
    begin
      Rails[k].FCalcVolt := NewVolt[k];
      Changed := True;
      if AInval then
      begin
        Rails[k].UpdateHintText;
        Rails[k].Invalidate;
      end;
    end;
  if Changed and AInval then
    P.Invalidate;   // kleur van de stekkers

  // stroom per draad, voor de elektronen (alleen als een bron ze toont).
  // Elke klem/rail neemt een stroom uit de draden (de stroom door het
  // onderdeel); per knooppunt volgt de stroom in de draden uit de
  // stroomwet van Kirchhoff, over een opspannende boom van de draden.
  Toon := False;
  for k := 0 to NP - 1 do
    if (Parts[k] is TjanBron) and TjanBron(Parts[k]).Elektronen then Toon := True;
  NI := 2 * NP + NR;
  SetLength(Draad, 0); SetLength(DrA, 0); SetLength(DrB, 0);
  ND := 0;
  for i := 0 to P.ControlCount - 1 do
    if (P.Controls[i] is TjanConnector) then
    begin
      Con := TjanConnector(P.Controls[i]);
      A := -1; B := -1;
      if Toon and Con.Visible then
      begin
        Con.EndCenters(Pa, Pb);
        A := ItemAt(Pa);
        B := ItemAt(Pb);
      end;
      Con.FStroomNieuw := 0;
      if (A < 0) or (B < 0) or (A = B) then
      begin
        Continue;
      end;
      SetLength(Draad, ND + 1); SetLength(DrA, ND + 1); SetLength(DrB, ND + 1);
      Draad[ND] := Con; DrA[ND] := A; DrB[ND] := B;
      Inc(ND);
    end;
  // spanning over de verbruikers op de rails
  U := 0;
  if (LoadG > 0) and (LoadItA >= 0) and (LoadItB >= 0) then
    U := V[NodeOf[LoadItA]] - V[NodeOf[LoadItB]];
  if ND = 0 then
  begin
    ElektronenRails(P, U, Toon);
    Exit;
  end;
  SetLength(Vraag, NI);
  for i := 0 to NI - 1 do Vraag[i] := 0;
  for k := 0 to NP - 1 do
  begin
    if Parts[k] is TjanBron then Amp := -TjanBron(Parts[k]).FStroom else Amp := Parts[k].FAmp;
    Vraag[2 * k] := Amp;
    Vraag[2 * k + 1] := -Amp;
  end;
  if (LoadG > 0) and (LoadItA >= 0) and (LoadItB >= 0) then
  begin
    Amp := LoadG * (V[NodeOf[LoadItA]] - V[NodeOf[LoadItB]]);
    Vraag[LoadItA] := Vraag[LoadItA] + Amp;
    Vraag[LoadItB] := Vraag[LoadItB] - Amp;
  end;
  // buren per klem/rail (lijst met beginpunten)
  SetLength(BuurStart, NI + 1);
  for i := 0 to NI do BuurStart[i] := 0;
  for m := 0 to ND - 1 do
  begin
    Inc(BuurStart[DrA[m] + 1]);
    Inc(BuurStart[DrB[m] + 1]);
  end;
  for i := 1 to NI do BuurStart[i] := BuurStart[i] + BuurStart[i - 1];
  SetLength(Buur, 2 * ND); SetLength(BuurDraad, 2 * ND);
  SetLength(Volg, NI);
  for i := 0 to NI - 1 do Volg[i] := BuurStart[i];
  for m := 0 to ND - 1 do
  begin
    Buur[Volg[DrA[m]]] := DrB[m]; BuurDraad[Volg[DrA[m]]] := m; Inc(Volg[DrA[m]]);
    Buur[Volg[DrB[m]]] := DrA[m]; BuurDraad[Volg[DrB[m]]] := m; Inc(Volg[DrB[m]]);
  end;
  // breedte-eerst door elk deel; Volg wordt de bezoekvolgorde
  SetLength(Gezien, NI); SetLength(OuderIt, NI); SetLength(OuderDraad, NI);
  for i := 0 to NI - 1 do
  begin
    Gezien[i] := False; OuderIt[i] := -1; OuderDraad[i] := -1;
  end;
  Staart := 0;
  for i := 0 to NI - 1 do
    if not Gezien[i] then
    begin
      Gezien[i] := True;
      Kop := Staart;
      Volg[Staart] := i; Inc(Staart);
      while Kop < Staart do
      begin
        A := Volg[Kop]; Inc(Kop);
        for j := BuurStart[A] to BuurStart[A + 1] - 1 do
          if not Gezien[Buur[j]] then
          begin
            B := Buur[j];
            Gezien[B] := True;
            OuderIt[B] := A;
            OuderDraad[B] := BuurDraad[j];
            Volg[Staart] := B; Inc(Staart);
          end;
      end;
    end;
  // van de bladeren naar de wortel: de stroom in de draad naar een klem is
  // alles wat die klem en alles daarachter uit de draden neemt
  SetLength(Sub, NI);
  for i := 0 to NI - 1 do Sub[i] := Vraag[i];
  SetLength(Gezien, ND);
  for m := 0 to ND - 1 do Gezien[m] := False;
  for k := NI - 1 downto 0 do
  begin
    B := Volg[k];
    A := OuderIt[B];
    if A < 0 then Continue;
    m := OuderDraad[B];
    Gezien[m] := True;
    // stroom van A naar B door draad m
    if DrA[m] = A then Draad[m].FStroomNieuw := Sub[B] else Draad[m].FStroomNieuw := -Sub[B];
    Sub[A] := Sub[A] + Sub[B];
  end;
  for m := 0 to ND - 1 do
    if not Gezien[m] then Draad[m].FStroomNieuw := 0;
  ElektronenRails(P, U, Toon);
end;

// spanning op klem APin van voedingsonderdeel D (voor een draad die daar begint)
function VoedingsPinVolt(D: TjanVoedingsDeel; APin: Integer): Double;
begin
  if (APin >= 0) and (APin <= 1) then
    Result := D.FPinV[APin]
  else
    Result := 0;
end;

// regel in het paneelbestand voor bron, zekering of milliampèremeter
function VoedingFileLine(C: TControl): string;
begin
  if C is TjanBron then
    Result := Format('TjanBron;%d;%d;%d;%d;%d;%d;%d;', [C.Height, C.Left, C.Top, C.Width,
      Round(TjanBron(C).Volt * 10), TjanBron(C).RiIdx, Ord(TjanBron(C).Elektronen)])
  else if C is TjanZekering then
    Result := Format('TjanZekering;%d;%d;%d;%d;%d;', [C.Height, C.Left, C.Top, C.Width,
      TjanZekering(C).NomIdx])
  else if C is TjanWeerstand then
    Result := Format('TjanWeerstand;%d;%d;%d;%d;%d;', [C.Height, C.Left, C.Top, C.Width,
      TjanWeerstand(C).Soort])
  else if C is TjanLamp2 then
    Result := Format('TjanLamp2;%d;%d;%d;%d;%d;', [C.Height, C.Left, C.Top, C.Width,
      TjanLamp2(C).Soort])
  else if C is TjanSchakelaar2 then
    Result := Format('TjanSchakelaar2;%d;%d;%d;%d;%d;', [C.Height, C.Left, C.Top, C.Width,
      Ord(TjanSchakelaar2(C).Aan)])
  else if C is TjanVoltmeter2 then
    Result := Format('TjanVoltmeter2;%d;%d;%d;%d;', [C.Height, C.Left, C.Top, C.Width])
  else
    Result := Format('TjanAmpMeter;%d;%d;%d;%d;', [C.Height, C.Left, C.Top, C.Width]);
end;

{ TjanVoedingsDeel }

constructor TjanVoedingsDeel.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  FConnectors := TList.Create;
  FTaal := 'NL';
  ShowHint := True;
  HelpKeyword := 'voeding';
end;

destructor TjanVoedingsDeel.Destroy;
begin
  FConnectors.Free;
  inherited Destroy;
end;

function TjanVoedingsDeel.PinCenter(I: Integer): TPoint;
var
  Q: TPoint;
begin
  Q := PinPos(I);
  Result := Point(Left + Q.X + 3, Top + Q.Y + 3);
end;

function TjanVoedingsDeel.PinAt(const P: TPoint): Integer;
var
  i: Integer;
  C: TPoint;
begin
  for i := 0 to PinCount - 1 do
  begin
    C := PinCenter(i);
    if (Abs(C.X - P.X) <= VoedingPinTol) and (Abs(C.Y - P.Y) <= VoedingPinTol) then
      Exit(i);
  end;
  Result := -1;
end;

procedure TjanVoedingsDeel.PaintPin(X, Y: Integer; AOn: Boolean);
begin
  with Canvas do
  begin
    Brush.Style := bsSolid;
    if AOn then Brush.Color := clLime else Brush.Color := clGreen;
    FillRect(Rect(X, Y, X + 7, Y + 7));
    Pen.Color := clBlack;
    Pen.Style := psSolid;
    Brush.Style := bsClear;
    Rectangle(Rect(X, Y, X + 7, Y + 7));
  end;
end;

procedure TjanVoedingsDeel.PaintSelection;
begin
  if not FSelected then Exit;
  with Canvas do
  begin
    Brush.Style := bsClear;
    Pen.Color := clRed; Pen.Style := psDot; Pen.Width := 1;
    Rectangle(ClientRect);
    Pen.Style := psSolid;
    Brush.Style := bsSolid;
  end;
end;

procedure TjanVoedingsDeel.SetTaal(const Value: string);
begin
  FTaal := Value;
  UpdateHintText;
  Invalidate;
end;

procedure TjanVoedingsDeel.AddMenuItems(APop: TPopupMenu);
begin
end;

function TjanVoedingsDeel.HandleClick(X, Y: Integer): Boolean;
begin
  Result := False;
end;

procedure TjanVoedingsDeel.LockClick(Sender: TObject);
begin
  FLock := not FLock;
end;

procedure TjanVoedingsDeel.InfoClick(Sender: TObject);
begin
  ShowHint := not ShowHint;
end;

procedure TjanVoedingsDeel.SelectClick(Sender: TObject);
begin
  if Assigned(FBox) then
    FBox.SelectObject(Self);
end;

procedure TjanVoedingsDeel.AnchorConnectors;
var
  i: Integer;
  Con: TjanConnector;
  R: TRect;
begin
  FConnectors.Clear;
  if Parent = nil then Exit;
  R := BoundsRect;
  InflateRect(R, 8, 0);
  for i := 0 to Parent.ControlCount - 1 do
    if Parent.Controls[i] is TjanConnector then
    begin
      Con := TjanConnector(Parent.Controls[i]);
      if Con.AnchorToRect(R, Point(Left, Top)) then
        FConnectors.Add(Con);
    end;
end;

procedure TjanVoedingsDeel.MoveConnectors;
var
  i: Integer;
begin
  for i := 0 to FConnectors.Count - 1 do
    TjanConnector(FConnectors[i]).MoveConnector(Point(FNewLeft, FNewTop));
end;

procedure TjanVoedingsDeel.MouseDown(Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
var
  Pop: TPopupMenu;
  Mi: TMenuItem;
  Pt: TPoint;
  K: Integer;
begin
  inherited MouseDown(Button, Shift, X, Y);
  FDoMove := False;
  FMdp := Point(X, Y);
  if Button = mbRight then
  begin
    Pop := TPopupMenu.Create(Self);
    AddMenuItems(Pop);
    if Pop.Items.Count > 0 then
    begin
      Mi := TMenuItem.Create(Pop);
      Mi.Caption := '-';
      Pop.Items.Add(Mi);
    end;
    Mi := TMenuItem.Create(Pop);
    if FLock then
      Mi.Caption := Tr(FTaal, 'Ontgrendel', 'Unlock', 'Déverrouiller', 'Entsperren')
    else
      Mi.Caption := Tr(FTaal, 'Vergrendel', 'Lock', 'Verrouiller', 'Sperren');
    Mi.OnClick := LockClick;
    Pop.Items.Add(Mi);
    Mi := TMenuItem.Create(Pop);
    if ShowHint then
      Mi.Caption := Tr(FTaal, 'Info uit', 'Information off', 'Infos off', 'Infos aus')
    else
      Mi.Caption := Tr(FTaal, 'Info aan', 'Information on', 'Infos on', 'Infos an');
    Mi.OnClick := InfoClick;
    Pop.Items.Add(Mi);
    Mi := TMenuItem.Create(Pop);
    if FSelected then
      Mi.Caption := Tr(FTaal, 'Deselecteer object', 'Deselect object', 'Désélectionner l''objet', 'Objekt abwählen')
    else
      Mi.Caption := Tr(FTaal, 'Selecteer object', 'Select object', 'Sélectionner un objet', 'Objekt auswählen');
    Mi.OnClick := SelectClick;
    Pop.Items.Add(Mi);
    Pt := ClientToScreen(Point(0, Height));
    Pop.Popup(Pt.X, Pt.Y - 1);
    Exit;
  end;
  // met de knop Verbinding: een draad beginnen op een klem
  if (Button = mbLeft) and (Screen.Cursor = crDraad) and (Parent <> nil) then
  begin
    K := PinAt(Point(Left + X, Top + Y));
    if K >= 0 then
    begin
      Pt := PinCenter(K);
      Maakdraad(Pt.Y - 4, Pt.X - 4, Parent);
      movecursor;
      BringToFront;
      Exit;
    end;
  end;
  if Button <> mbLeft then Exit;
  // eigen bediening (schuifregelaar) werkt ook tijdens de simulatie
  if HandleClick(X, Y) then Exit;
  FDoMove := True;
  AnchorConnectors;
  if Parent is TjanGridS then
    TjanGridS(Parent).BeginGuideLines(Left + Width div 2, Top + Height div 2);
end;

procedure TjanVoedingsDeel.MouseMove(Shift: TShiftState; X, Y: Integer);
var
  P, SnapP: TPoint;
  Grid: TjanGridS;
begin
  inherited MouseMove(Shift, X, Y);
  if FLock or (Parent = nil) or not FDoMove or not (ssLeft in Shift) then Exit;
  P := Parent.ScreenToClient(ClientToScreen(Point(X, Y)));
  FNewLeft := P.X - FMdp.X;
  FNewTop := P.Y - FMdp.Y;
  if Parent is TjanGridS then
  begin
    Grid := TjanGridS(Parent);
    SnapP := Grid.SnapPointToRuler(Point(FNewLeft + Width div 2, FNewTop + Height div 2),
      Grid.GetWorkAreaRect);
    FNewLeft := SnapP.X - Width div 2;
    FNewTop := SnapP.Y - Height div 2;
  end;
  StraightenWires(FConnectors, FNewLeft, FNewTop);
  Left := FNewLeft;
  Top := FNewTop;
  MoveConnectors;
  if Parent is TjanGridS then
    TjanGridS(Parent).UpdateGuideLines(Left + Width div 2, Top + Height div 2);
  if Assigned(GlobalSimBox) then
    GlobalSimBox.DoObjectMove(Self, Left, Top);
  SendStatusToBar;
end;

procedure TjanVoedingsDeel.MouseUp(Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
begin
  inherited MouseUp(Button, Shift, X, Y);
  FDoMove := False;
  if Parent is TjanGridS then
    TjanGridS(Parent).EndGuideLines;
  if Parent <> nil then
    UpdateSupply(Parent, True);
end;

procedure TjanVoedingsDeel.CMMouseEnter(var Msg: TMessage);
begin
  inherited;
  UpdateHintText;
  SendStatusToBar;
end;

procedure TjanVoedingsDeel.CMMouseLeave(var Msg: TMessage);
begin
  inherited;
  if Assigned(FOnStatus) then
  begin
    FOnStatus(Self, '', 0);
    FOnStatus(Self, '', 1);
    FOnStatus(Self, '', 2);
    FOnStatus(Self, '', 3);
  end;
end;

{ TjanBron }

constructor TjanBron.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  Width := BronW;
  Height := BronH;
  FVolt := BronMaxVolt;
  FRiIdx := 1;            // 0,5 ohm
  FKlem := FVolt;
end;

function TjanBron.PinCount: Integer;
begin
  Result := 2;
end;

// klemmen onderaan: + links, - rechts
function TjanBron.PinPos(I: Integer): TPoint;
begin
  if I = 0 then Result := Point(4, BronH - 10) else Result := Point(BronW - 10, BronH - 10);
end;

function TjanBron.Ri: Double;
begin
  Result := BronRi[FRiIdx];
end;

procedure TjanBron.SetVolt(const Value: Double);
var
  V: Double;
begin
  V := Round(Value * 2) / 2;           // stappen van 0,5 V
  if V < 0 then V := 0;
  if V > BronMaxVolt then V := BronMaxVolt;
  if Abs(V - FVolt) < 0.001 then Exit;
  FVolt := V;
  Invalidate;
  if Parent <> nil then
    UpdateSupply(Parent, True);
  SendStatusToBar;
end;

procedure TjanBron.SetRiIdx(const Value: Integer);
begin
  if (Value < Low(BronRi)) or (Value > High(BronRi)) or (Value = FRiIdx) then Exit;
  FRiIdx := Value;
  Invalidate;
  if Parent <> nil then
    UpdateSupply(Parent, True);
end;

function TjanBron.SliderRect: TRect;
begin
  Result := Rect(10, 54, 86, 60);
end;

procedure TjanBron.SlideTo(X: Integer);
var
  R: TRect;
begin
  R := SliderRect;
  Volt := (X - R.Left) / (R.Right - R.Left) * BronMaxVolt;
end;

function TjanBron.HandleClick(X, Y: Integer): Boolean;
var
  R: TRect;
begin
  R := SliderRect;
  InflateRect(R, 4, 6);
  Result := PtInRect(R, Point(X, Y));
  if Result then
  begin
    FSliding := True;
    SlideTo(X);
  end;
end;

procedure TjanBron.MouseMove(Shift: TShiftState; X, Y: Integer);
begin
  if FSliding then
  begin
    if ssLeft in Shift then SlideTo(X) else FSliding := False;
    Exit;
  end;
  inherited MouseMove(Shift, X, Y);
end;

procedure TjanBron.MouseUp(Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
begin
  FSliding := False;
  inherited MouseUp(Button, Shift, X, Y);
end;

