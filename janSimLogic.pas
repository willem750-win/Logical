      canvas.Lock;canvas.rectangle(R);canvas.Unlock;
      canvas.pen.Color:=clBlack;canvas.pen.style:=psSolid;
     end;
   // tekenen van rode kader na selectie via popupmenu in paint onderaan
   if Selected then
     begin
