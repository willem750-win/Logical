function TjanLogic.GetLogicFuncText: string;
begin
  case LogicFunc of
    jlfAND:
      Result := Tr(BTaal,'EN','AND','ET','UND');

    jlfOR:
      Result := Tr(BTaal,'OF','OR','OU','ODER');

    jlfNOT:
      Result := Tr(BTaal,'NIET','NOT','NON','NICHT');

  else
    Result := LogicFuncWoord(LogicFunc, BTaal);
  end;
end;


