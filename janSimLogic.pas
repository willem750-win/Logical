end;

function TjanSimMotor.Direction: Integer;
begin
  if FIn[0] and not FIn[1] then Result := -1
  else if FIn[1] and not FIn[0] then Result := 1
  else Result := 0;
end;

procedure TjanSimMotor.SetInput(I: Integer; Value: Boolean);
