procedure TjanSimLogicBox.Encode(tekst:TStringList);
var
  e,d: String;
  temp:TStringList;
  i: integer;
begin
  d:='';temp:=TStringlist.Create;
  for i:= 0 to tekst.count-1 do
    begin
    d:= tekst.Strings[i];
    e:=SZFullEncodeBase64(d);
    temp.Add(e)
    end;
    tekst.Clear;
    tekst.Assign(temp);
  temp.Free;
end;

procedure TjanSimLogicBox.decode(tekst:TStringList);
var
  e,d: string;
  i: integer;
  temp:TStringList;
begin
  d:='';temp:=TStringlist.Create;
  for i:= 0 to tekst.count-1 do
    Begin
    d:= tekst.Strings[i];
    e:=SZDecodeBase64(d);
    temp.Add(e)
    end;
    tekst.Clear;
    tekst.Assign(temp);
  temp.Free;
end;

