     draw(31,50,lBitUit);draw(56,50,lBitUit);draw(81,50,lBitUit);draw(106,50,lBitUit);
    Unlock;
   end;
   if select=true then
     begin
     R:=ClientRect;
      canvas.pen.Color:=clblack;
