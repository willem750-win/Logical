     Font.Size:=7;
     TextOut(39,19,'8');TextOut(63,19,'4');TextOut(87,18,'2');TextOut(111,18,'1');
     pen.Color:=clSilver;
     MoveTo(48,15);LineTo(48,height-20);MoveTo(72,15);LineTo(72,height-20);MoveTo(96,15);LineTo(96,height-20);
     lUit.Transparent := True;
     draw(126,40,lUit);
     draw(0,10,lIn);
     draw(0,50,lIn);
