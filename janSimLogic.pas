procedure TjanDipSwitsh.SetDown8(const Value: boolean);
begin
  if value<>FDown8 then
  begin
   FDown8 := Value;
   FDepressed8:=value;
   If Value=true then Fpuls8:=8 else FPuls8:=0;
   FPuls:=FPuls8+FPuls4+FPuls2+FPuls1;
   invalidate;
  end;
end;
procedure TjanDipSwitsh.SetDown4(const Value: boolean);
