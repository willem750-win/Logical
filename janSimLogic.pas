        begin
          KnopDown.Canvas.Pixels[XX, YY] := clFuchsia;  // Zet pixelkleur naar een transparante kleur
        end;
      end;
  KnopDown.Transparent := True;
  KnopDown.TransParentColor := clFuchsia;//:= KnopDown.canvas.pixels[0,0];
