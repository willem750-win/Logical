procedure TjanLamp2.AddMenuItems(APop: TPopupMenu);
var
  Mi, Sub: TMenuItem;
  i: Integer;
begin
  Mi := TMenuItem.Create(APop);
  Mi.Caption := Tr(FTaal, 'Weerstand', 'Resistance', 'Résistance', 'Widerstand');
  APop.Items.Add(Mi);
