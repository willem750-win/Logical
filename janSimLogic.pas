var
  I: Double;
begin
  I := Abs(FAmp);
  Hint := Tr(FTaal, 'Lamp', 'Lamp', 'Lampe', 'Lampe') + ' (' + OhmText(Ohm) + ')' + #13#10;
  if I > 0.00005 then
    Hint := Hint +
      'U = I × R = ' + AmpText(I) + ' × ' + OhmText(Ohm) + ' = ' + VoltText(Spanning) + #13#10 +
      'I = U / R = ' + VoltText(Spanning) + ' / ' + OhmText(Ohm) + ' = ' + AmpText(I) +
        ' = ' + MilliAmpText(I) + #13#10 +
