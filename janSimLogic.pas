// veld N (vanaf 0) van een regel met ; als scheiding, '' als het ontbreekt
function VeldNr(const S: string; N: Integer): string;
var
  i, k, Start: Integer;
begin
  Result := '';
  k := 0;
  Start := 1;
  for i := 1 to Length(S) + 1 do
    if (i > Length(S)) or (S[i] = ';') then
    begin
      if k = N then
        Exit(Trim(Copy(S, Start, i - Start)));
      Inc(k);
      Start := i + 1;
    end;
end;

