#: uhelpmanager.pas:226
msgid "Button / Switch\n\n- Simulates a binary input or output.\n- Left mouse click usually changes the state.\n- Right mouse click opens extra settings.\n- Name and state can be shown in the status bar."
msgstr ""

#: uhelpmanager.pas:248
msgid "Switch\n\n- Simulates an on/off switch.\n- Can be selected and operated.\n- Name and state can be shown in the status bar."
msgstr ""

#: uhelpmanager.pas:267
msgid "Logic block\n\n- Processes inputs according to a logic function.\n- Supported functions may include AND, OR and NOT.\n- The selected function can be shown in the status bar or hint."
msgstr ""

#: uhelpmanager.pas:286
msgid "Power rail\n\n- + rail: plug inputs in on the right; the voltage comes from the source.\n- - rail (ground): plug outputs in on the left.\n- Drag the middle to move, drag an end to resize."
msgstr ""

#: uhelpmanager.pas:305
msgid "Source (battery)\n\n- Slider: 0 to 12 V in steps of 0.5 V.\n- + with a wire to the + rail, - to the - rail.\n- Right-click: internal resistance."
msgstr ""

#: uhelpmanager.pas:324
msgid "Fuse\n\n- In series between the source and the + rail.\n- Blows when the current is too high.\n- Right-click: rated current, replace fuse."
msgstr ""

#: uhelpmanager.pas:342
msgid "Milliammeter\n\n- In series between the source and the + rail.\n- Shows the current the circuit uses."
msgstr ""

#: uhelpmanager.pas:359
msgid "Resistance (contact)\n\n- In series in the supply line: voltage drop U = I x R.\n- Good contact 0.05 ohm, long thin wire 1 ohm, poor contact 2 ohm, burnt contact 10 ohm.\n- Measure the voltage drop with a voltmeter across both terminals.\n- Right-click: choose the kind."
msgstr ""

#: uhelpmanager.pas:380
msgid "Voltmeter\n\n- Shows the voltage on the + against ground.\n- + via a wire or plugged onto a + rail."
msgstr ""

#: uhelpmanager.pas:396
msgid "Connector / Wire\n\n- Connects objects together.\n- Can be selected for editing or deleting.\n- Popup menu may contain extra actions."
msgstr ""

#: uhelpmanager.pas:414
msgid "Sensor\n\n- Represents a detection or input component.\n- Usually provides a binary state."
msgstr ""

#: uhelpmanager.pas:428
msgid "Heating / Warm element\n\n- Represents a heating output or warm symbol."
msgstr ""

#: uhelpmanager.pas:440
msgid "Pulse\n\n- Generates or shows a temporary pulse.\n- Useful for triggers or test signals."
msgstr ""

#: uhelpmanager.pas:454
msgid "DIP switch\n\n- Allows multiple fixed binary settings."
msgstr ""

#: uhelpmanager.pas:467
msgid "Grid\n\n- Supports object placement, selection and frame drawing.\n- Can use SnapToGrid, guide lines and rulers.\n- Title and work area can be handled separately."
msgstr ""

