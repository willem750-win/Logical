# --- guida (uhelpmanager) ---
msgid "Button / Switch\n\n- Simulates a binary input or output.\n- Left mouse click usually changes the state.\n- Right mouse click opens extra settings.\n- Name and state can be shown in the status bar."
msgstr "Pulsante / Interruttore\n\n- Simula un ingresso o un'uscita binaria.\n- Il clic sinistro di solito cambia lo stato.\n- Il clic destro apre altre impostazioni.\n- Nome e stato possono comparire nella barra di stato."

msgid "Switch\n\n- Simulates an on/off switch.\n- Can be selected and operated.\n- Name and state can be shown in the status bar."
msgstr "Interruttore\n\n- Simula un interruttore acceso/spento.\n- Si può selezionare e azionare.\n- Nome e stato possono comparire nella barra di stato."

msgid "Logic block\n\n- Processes inputs according to a logic function.\n- Supported functions may include AND, OR and NOT.\n- The selected function can be shown in the status bar or hint."
msgstr "Blocco logico\n\n- Elabora gli ingressi secondo una funzione logica.\n- Funzioni possibili: AND, OR e NOT.\n- La funzione scelta può comparire nella barra di stato o nel suggerimento."

msgid "Power rail\n\n- + rail: plug inputs in on the right; right-click for the voltage.\n- - rail (ground): plug outputs in on the left.\n- Drag the middle to move, drag an end to resize."
msgstr "Barra di alimentazione\n\n- barra +: inserisci gli ingressi a destra; tasto destro per la tensione.\n- barra - (massa): inserisci le uscite a sinistra.\n- Trascina il centro per spostarla, un'estremità per ridimensionarla."

msgid "Voltmeter\n\n- Shows the voltage on the + against ground.\n- + via a wire or plugged onto a + rail."
msgstr "Voltmetro\n\n- Mostra la tensione sul + rispetto alla massa.\n- + tramite un filo o inserito su una barra +."

msgid "Connector / Wire\n\n- Connects objects together.\n- Can be selected for editing or deleting.\n- Popup menu may contain extra actions."
msgstr "Collegamento / Filo\n\n- Collega gli oggetti tra loro.\n- Si può selezionare per modificarlo o eliminarlo.\n- Il menu contestuale può contenere altre azioni."

msgid "Sensor\n\n- Represents a detection or input component.\n- Usually provides a binary state."
msgstr "Sensore\n\n- Rappresenta un componente di rilevamento o di ingresso.\n- Di solito fornisce uno stato binario."

msgid "Heating / Warm element\n\n- Represents a heating output or warm symbol."
msgstr "Riscaldamento / Elemento caldo\n\n- Rappresenta un'uscita di riscaldamento o un simbolo di calore."

msgid "Pulse\n\n- Generates or shows a temporary pulse.\n- Useful for triggers or test signals."
msgstr "Impulso\n\n- Genera o mostra un impulso temporaneo.\n- Utile per comandi o segnali di prova."

msgid "DIP switch\n\n- Allows multiple fixed binary settings."
msgstr "Interruttore DIP\n\n- Permette più impostazioni binarie fisse."

msgid "Grid\n\n- Supports object placement, selection and frame drawing.\n- Can use SnapToGrid, guide lines and rulers.\n- Title and work area can be handled separately."
msgstr "Griglia\n\n- Per posizionare e selezionare oggetti e disegnare cornici.\n- Può usare l'aggancio alla griglia, linee guida e righelli.\n- Titolo e area di lavoro si gestiscono separatamente."

msgid "No specific help found for keyword: "
msgstr "Nessuna guida specifica trovata per la parola chiave: "

msgid "\n\nExpected help page:\n"
msgstr "\n\nPagina della guida attesa:\n"

msgid "No HelpKeyword assigned."
msgstr "Nessuna parola chiave della guida assegnata."

msgid "No internal help handler assigned.\n"
msgstr "Nessun gestore interno della guida assegnato.\n"

msgid "Table of contents not found.\n"
msgstr "Indice non trovato.\n"

