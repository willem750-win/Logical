msgstr "Lámpara de 2 bornes"

msgid "Switch with 2 terminals"
msgstr "Interruptor de 2 bornes"

msgid "Voltmeter with 2 terminals"
msgstr "Voltímetro de 2 bornes"

msgid "create Lamp with 2 terminals (series and parallel)"
msgstr "crear lámpara de 2 bornes (serie y paralelo)"

msgid "create Switch with 2 terminals"
msgstr "crear interruptor de 2 bornes"

