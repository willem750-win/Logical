msgid "+ rail (supply):"
msgstr "+ 电源轨 (电源):"

msgid "Plug inputs in on the right of the rail. Below 2V no signal.\nThe voltage comes from the source (battery). Drag the ends to resize."
msgstr "输入插在电源轨右侧。低于 2V 无信号。\n电压来自电源 (电池)。拖动两端可调整大小。"

msgid "Internal resistance"
msgstr "内阻"

msgid "Source (battery)"
msgstr "电源 (电池)"

msgid "Slider: voltage 0 to 12 V.\n+ with a wire to the + rail, - to the - rail.\nRight-click: internal resistance."
msgstr "滑块: 电压 0 到 12 V。\n+ 用导线接到 + 电源轨，- 接到 - 电源轨。\n右键: 内阻。"

msgid "Replace fuse"
msgstr "更换保险丝"

msgid "Rated current"
msgstr "额定电流"

msgid "Fuse"
msgstr "保险丝"

msgid "In series between the source and the + rail.\nBlows when the current is too high: right-click to replace."
msgstr "串联在电源和 + 电源轨之间。\n电流过大时熔断: 右键更换。"

msgid "blown"
msgstr "已熔断"

msgid "OK"
msgstr "正常"

msgid "Milliammeter"
msgstr "毫安表"

msgid "In series between the source and the + rail.\nShows the current the circuit uses."
msgstr "串联在电源和 + 电源轨之间。\n显示电路消耗的电流。"

msgid "create Source (battery, 0 to 12 V)"
msgstr "创建电源 (电池，0 到 12 V)"

msgid "create Fuse"
msgstr "创建保险丝"

msgid "create Milliammeter"
msgstr "创建毫安表"

msgid "good contact"
msgstr "接触良好"

msgid "long thin wire"
msgstr "细长导线"

msgid "poor contact"
msgstr "接触不良"

msgid "burnt contact"
msgstr "烧坏的触点"

msgid "Kind"
msgstr "类型"

msgid "Resistance"
msgstr "电阻"

msgid "In series in the supply line: some voltage is lost (U = I × R).\nMeasure it with a voltmeter across both terminals. Right-click: choose the kind."
msgstr "串联在供电线路中：会损失一部分电压 (U = I × R)。\n用电压表接在两个端子之间测量。右键：选择类型。"

msgid "create Resistance (contact, long wire)"
msgstr "创建电阻（触点、长导线）"

msgid "Power rail\n\n- + rail: plug inputs in on the right; the voltage comes from the source.\n- - rail (ground): plug outputs in on the left.\n- Drag the middle to move, drag an end to resize."
msgstr "电源轨\n\n- + 轨：输入插在右侧；电压来自电源。\n- - 轨（地）：输出插在左侧。\n- 拖动中间可移动，拖动一端可调整长度。"

msgid "Source (battery)\n\n- Slider: 0 to 12 V in steps of 0.5 V.\n- + with a wire to the + rail, - to the - rail.\n- Right-click: internal resistance."
msgstr "电源（电池）\n\n- 滑块：0 到 12 V，步长 0.5 V。\n- + 用导线接到 + 轨，- 接到 - 轨。\n- 右键：内阻。"

msgid "Fuse\n\n- In series between the source and the + rail.\n- Blows when the current is too high.\n- Right-click: rated current, replace fuse."
msgstr "保险丝\n\n- 串联在电源和 + 轨之间。\n- 电流过大时熔断。\n- 右键：额定电流、更换保险丝。"

msgid "Milliammeter\n\n- In series between the source and the + rail.\n- Shows the current the circuit uses."
msgstr "毫安表\n\n- 串联在电源和 + 轨之间。\n- 显示电路消耗的电流。"

msgid "Resistance (contact)\n\n- In series in the supply line: voltage drop U = I x R.\n- Good contact 0.05 ohm, long thin wire 1 ohm, poor contact 2 ohm, burnt contact 10 ohm.\n- Measure the voltage drop with a voltmeter across both terminals.\n- Right-click: choose the kind."
msgstr "电阻（触点）\n\n- 串联在供电线路中：电压降 U = I x R。\n- 接触良好 0.05 Ω，细长导线 1 Ω，接触不良 2 Ω，烧坏的触点 10 Ω。\n- 用电压表接在两个端子之间测量电压降。\n- 右键：选择类型。"

msgid "Resistance (contact)"
msgstr "电阻（触点）"

