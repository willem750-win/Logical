# LogicCEF: uitvoermap bevat exe, CEF-runtime, cache en gegenereerde help.
# Alleen de echte data bijhouden.
projects/LogicCEF/Resultaat/*
!projects/LogicCEF/Resultaat/panels/
!projects/LogicCEF/Resultaat/ini/
!projects/LogicCEF/Resultaat/html/
!projects/LogicCEF/Resultaat/ImmoSetup/
# extra talen (zie projects/LogicCEF/uLangPo.pas); missing-*.pot maakt Logic zelf met --po-collect
!projects/LogicCEF/Resultaat/lang/
projects/LogicCEF/Resultaat/lang/missing-*.pot

# Wordt door het programma zelf aangemaakt
projects/LogicCEF/Resultaat/ini/comboColor.ini

# Uitvoer van make-linux-release.sh
projects/LogicCEF/release/

# Eigen testpanelen (niet voor de release)
projects/LogicCEF/testpanelen/
